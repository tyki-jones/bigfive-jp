    "id": 39,
    "trait": "conscientiousness",
    "facet": "勤勉性",
    "reverse_scored": false,
    "text_jp": "始めたことは最後までやり遂げる。"
  },
  {
    "id": 40,
    "trait": "conscientiousness",
    "facet": "責任感",
    "reverse_scored": true,
    "text_jp": "お金や時間を深く考えずに使ってしまう。"
  },
