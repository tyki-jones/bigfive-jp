    "id": 49,
    "trait": "agreeableness",
    "facet": "思いやり",
    "reverse_scored": false,
    "text_jp": "困っている人を見ると手を貸したくなる。"
  },
  {
    "id": 50,
    "trait": "agreeableness",
    "facet": "礼儀",
    "reverse_scored": true,
    "text_jp": "言い合いになると相手を言い負かしたくなる。"
  },
