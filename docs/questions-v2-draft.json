    "trait": "conscientiousness",
    "facet": "責任感",
    "reverse_scored": false,
    "text_jp": "約束の時間は必ず守る。"
  },
  {
    "id": 42,
    "trait": "conscientiousness",
    "facet": "秩序",
    "reverse_scored": true,
    "text_jp": "物をどこに置いたか、よく忘れる。"
  },
