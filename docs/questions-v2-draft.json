    "id": 43,
    "trait": "conscientiousness",
    "facet": "秩序",
    "reverse_scored": false,
    "text_jp": "予定は前もって立てておく。"
  },
  {
    "id": 44,
    "trait": "conscientiousness",
    "facet": "勤勉性",
    "reverse_scored": true,
    "text_jp": "作業の途中で、ほかのことに気を取られやすい。"
  },
  {
    "id": 45,
    "trait": "conscientiousness",
    "facet": "勤勉性",
    "reverse_scored": false,
    "text_jp": "やるべきことがあるとすぐに取りかかる。"
  },
  {
    "id": 46,
    "trait": "conscientiousness",
    "facet": "責任感",
    "reverse_scored": true,
    "text_jp": "面倒な手続きや連絡はつい人任せにしてしまう。"
  },
