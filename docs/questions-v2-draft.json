    "id": 51,
    "trait": "agreeableness",
    "facet": "礼儀",
    "reverse_scored": false,
    "text_jp": "意見が違う相手にも、ていねいに接する。"
  },
  {
    "id": 52,
    "trait": "agreeableness",
    "facet": "信頼",
    "reverse_scored": true,
    "text_jp": "人の親切には、何か裏があるのではと考えてしまう。"
  },
  {
    "id": 53,
    "trait": "agreeableness",
    "facet": "信頼",
    "reverse_scored": false,
    "text_jp": "たいていの人は、根は善い人だと思う。"
  },
  {
    "id": 54,
    "trait": "agreeableness",
    "facet": "思いやり",
    "reverse_scored": true,
    "text_jp": "他人のもめごとからは距離を置く。"
  },
  {
    "id": 55,
    "trait": "agreeableness",
    "facet": "思いやり",
    "reverse_scored": false,
    "text_jp": "人の悩みを聞くと、自分のことのように気になる。"
  },
  {
    "id": 56,
    "trait": "agreeableness",
    "facet": "礼儀",
    "reverse_scored": true,
    "text_jp": "人の欠点が目につくと、つい指摘してしまう。"
  },
  {
    "id": 57,
    "trait": "agreeableness",
    "facet": "礼儀",
    "reverse_scored": false,
    "text_jp": "人の話は最後まで聞くようにしている。"
  },
  {
    "id": 58,
    "trait": "agreeableness",
    "facet": "信頼",
    "reverse_scored": true,
    "text_jp": "人を信用するまでに時間がかかる。"
  },
  {
    "id": 59,
    "trait": "agreeableness",
    "facet": "信頼",
    "reverse_scored": false,
    "text_jp": "人に何かを任せるときは、相手を信じて任せる。"
  },
  {
    "id": 60,
    "trait": "agreeableness",
    "facet": "思いやり",
    "reverse_scored": true,
    "text_jp": "人の相談に乗るのは正直わずらわしい。"
  }
