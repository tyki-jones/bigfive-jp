[
  {
    "id": 1,
    "trait": "extraversion",
    "facet": "社交性",
    "reverse_scored": false,
    "text_jp": "初めて会う人ともすぐに打ち解けられる。"
  },
  {
    "id": 2,
    "trait": "extraversion",
    "facet": "自己主張",
    "reverse_scored": true,
    "text_jp": "目立つ役割はできれば人に任せたい。"
  },
  {
    "id": 3,
    "trait": "extraversion",
    "facet": "自己主張",
    "reverse_scored": false,
    "text_jp": "話し合いでは自分の意見をはっきり言う。"
  },
  {
    "id": 4,
    "trait": "extraversion",
    "facet": "活動性",
    "reverse_scored": true,
    "text_jp": "動き出すまでに、エンジンがかかるのが遅い。"
  },
  {
    "id": 5,
    "trait": "extraversion",
    "facet": "活動性",
    "reverse_scored": false,
    "text_jp": "空いた時間にはつい何か予定を入れてしまう。"
  },
  {
    "id": 6,
    "trait": "extraversion",
    "facet": "社交性",
    "reverse_scored": true,
    "text_jp": "大勢でいるより一人で過ごすほうが落ち着く。"
  },
  {
    "id": 7,
    "trait": "extraversion",
    "facet": "社交性",
    "reverse_scored": false,
    "text_jp": "飲み会やパーティーには喜んで参加する。"
  },
  {
    "id": 8,
    "trait": "extraversion",
    "facet": "自己主張",
    "reverse_scored": true,
    "text_jp": "会議や授業では指名されるまで発言しない。"
  },
  {
    "id": 9,
    "trait": "extraversion",
    "facet": "自己主張",
    "reverse_scored": false,
    "text_jp": "グループでは自然とまとめ役になる。"
  },
  {
    "id": 10,
    "trait": "extraversion",
    "facet": "活動性",
    "reverse_scored": true,
    "text_jp": "どちらかというと、もの静かなタイプだ。"
  },
  {
    "id": 11,
    "trait": "extraversion",
    "facet": "活動性",
    "reverse_scored": false,
    "text_jp": "周りから元気で明るい人だと言われる。"
  },
  {
    "id": 12,
    "trait": "extraversion",
    "facet": "社交性",
    "reverse_scored": true,
    "text_jp": "自分から人に話しかけることは少ない。"
  },
  {
    "id": 13,
    "trait": "neuroticism",
    "facet": "不安",
    "reverse_scored": false,
    "text_jp": "先のことを考えて心配になることがよくある。"
  },
  {
    "id": 14,
    "trait": "neuroticism",
    "facet": "落ち込み",
    "reverse_scored": true,
    "text_jp": "毎日の生活におおむね満足している。"
  },
  {
    "id": 15,
    "trait": "neuroticism",
    "facet": "落ち込み",
    "reverse_scored": false,
    "text_jp": "理由もなく気分が沈む日がある。"
  },
  {
    "id": 16,
    "trait": "neuroticism",
    "facet": "感情の起伏",
    "reverse_scored": true,
    "text_jp": "腹が立ってもすぐに冷静になれる。"
  },
  {
    "id": 17,
    "trait": "neuroticism",
    "facet": "感情の起伏",
    "reverse_scored": false,
    "text_jp": "ささいなことで気分が大きく変わる。"
  },
  {
    "id": 18,
    "trait": "neuroticism",
    "facet": "不安",
    "reverse_scored": true,
    "text_jp": "たいていのことは「なんとかなる」と考えられる。"
  },
  {
    "id": 19,
    "trait": "neuroticism",
    "facet": "不安",
    "reverse_scored": false,
    "text_jp": "大事な場面の前は緊張して落ち着かなくなる。"
  },
  {
    "id": 20,
    "trait": "neuroticism",
    "facet": "落ち込み",
    "reverse_scored": true,
    "text_jp": "自分のことをわりと気に入っている。"
  },
  {
    "id": 21,
    "trait": "neuroticism",
    "facet": "落ち込み",
    "reverse_scored": false,
    "text_jp": "失敗すると何日も引きずってしまう。"
  },
  {
    "id": 22,
    "trait": "neuroticism",
    "facet": "感情の起伏",
    "reverse_scored": true,
    "text_jp": "気分はいつもだいたい一定だ。"
  },
  {
    "id": 23,
    "trait": "neuroticism",
    "facet": "感情の起伏",
    "reverse_scored": false,
    "text_jp": "カッとなって強い口調になってしまうことがある。"
  },
  {
    "id": 24,
    "trait": "neuroticism",
    "facet": "不安",
    "reverse_scored": true,
    "text_jp": "予定外のことが起きても、あわてずに対応できる。"
  },
  {
    "id": 25,
    "trait": "openness",
    "facet": "知的好奇心",
    "reverse_scored": false,
    "text_jp": "知らない分野の話を聞くと、もっと詳しく知りたくなる。"
  },
  {
    "id": 26,
    "trait": "openness",
    "facet": "美的感受性",
    "reverse_scored": true,
    "text_jp": "美術館や展示会は退屈に感じる。"
  },
  {
    "id": 27,
    "trait": "openness",
    "facet": "美的感受性",
    "reverse_scored": false,
    "text_jp": "音楽や絵に心を強く動かされる。"
  },
  {
    "id": 28,
    "trait": "openness",
    "facet": "想像力",
    "reverse_scored": true,
